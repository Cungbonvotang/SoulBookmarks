{
  "manifest_version": 3,
  "name": "Sổ Dấu Trang",
  "short_name": "Dấu Trang",
  "version": "2.7.0",
  "description": "Lưu dấu trang theo thư mục và nhãn, tìm theo tên, địa chỉ, nhãn, ngày; báo trang đang mở đã lưu hay chưa.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sổ Dấu Trang",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "key": ""
}
